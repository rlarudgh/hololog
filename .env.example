# .env.example

# Supabase Configuration
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database Connection
# Get from Supabase project settings: https://supabase.com/dashboard/project/_/settings/database
# Replace [YOUR-PASSWORD] with your database password
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres

# NextAuth Configuration
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret

# OAuth Providers (Optional)
# Google OAuth: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth: https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Blog API access (외부 사이트 연동용)
# 읽기 키: 쉼표로 여러 개 등록 가능(소비처별로 발급). 없거나 틀리면 401.
BLOG_API_KEYS=read-key-1,read-key-2
# 쓰기 키: POST/PUT/DELETE에 필요(읽기 키로는 쓰기 불가).
BLOG_API_WRITE_KEY=super-secret-write-key
# CORS 허용 출처. '*' 또는 쉼표 구분 도메인 목록(예: https://other-site.com,https://app.example.com)
BLOG_CORS_ORIGINS=*
# API 문서(/api-docs, /api/openapi) 노출 여부.
# 미설정 시 개발에서만 노출(프로덕션 배포에서는 404). 'true'로 강제 노출, 'false'로 강제 차단.
# ENABLE_API_DOCS=false

# Utterances comments configuration
NEXT_PUBLIC_UTTERANCES_REPO=your-username/your-repo

# Website URL
NEXT_PUBLIC_SITE_URL=https://hololog.vercel.app

# Google AdSense
NEXT_PUBLIC_ADSENSE_CLIENT=NEXT_PUBLIC_ADSENSE_CLIENT
