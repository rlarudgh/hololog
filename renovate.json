{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    ":semanticCommitTypeAll(chore)",
    ":semanticCommitScopeDisabled"
  ],
  "timezone": "Asia/Seoul",
  "schedule": ["every weekend"],
  "labels": ["dependencies", "renovate"],
  "assignees": ["rlarudgh"],
  "reviewers": ["rlarudgh"],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Renovate Dashboard",
  "dependencyDashboardLabels": ["renovate"],
  "rebaseWhen": "conflicted",
  "commitMessagePrefix": "chore(deps):",
  "commitMessageAction": "update",
  "commitMessageTopic": "{{depName}}",
  "semanticCommits": "enabled",
  "packageRules": [
    {
      "description": "Automerge patch and minor updates for devDependencies",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "requiredStatusChecks": ["CI"]
    },
    {
      "description": "Group major version updates for manual review",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["major", "dependencies"]
    },
    {
      "description": "Automatically group minor and patch updates",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major dependencies",
      "automerge": false
    },
    {
      "description": "pnpm lock file maintenance",
      "matchFileNames": ["pnpm-lock.yaml"],
      "schedule": ["before 3am on Monday"],
      "automerge": true
    },
    {
      "description": "Next.js and React updates (require manual review)",
      "matchPackageNames": ["next", "react", "react-dom"],
      "automerge": false,
      "labels": ["nextjs", "react", "dependencies"]
    },
    {
      "description": "Storybook updates (group together)",
      "matchPackagePrefixes": ["@storybook/"],
      "groupName": "storybook packages",
      "automerge": false
    },
    {
      "description": "Vitest updates (group together)",
      "matchPackagePrefixes": ["@vitest/", "vitest"],
      "groupName": "vitest packages",
      "automerge": false
    },
    {
      "description": "TypeScript updates (require manual review)",
      "matchPackageNames": ["typescript", "@types/*"],
      "automerge": false
    },
    {
      "description": "ESLint and plugins (group together)",
      "matchPackageNames": ["eslint", "*eslint*"],
      "groupName": "eslint packages",
      "automerge": false
    },
    {
      "description": "Separate PRs for major changes",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 3am on Monday"],
    "automerge": true
  },
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "assignees": ["rlarudgh"]
  },
  "prConcurrentLimit": 10,
  "prHourlyLimit": 2,
  "prCreation": "not-before-hours",
  "prNotBeforeHours": "48"
}
